# ==============================================================================
# 企业级多模态 RAG 生产架构环境配置模板 (.env.example)
# 复制本文件为 .env 并填入真实凭据即可启动
# 注意：大模型厂商 API Key 统一配置在 java-admin-service/.env.vault 中，严禁放入本文件！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 阿里云 OSS 对象存储 (真实云端接入模式)
# ------------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_rag_bucket_name

# ------------------------------------------------------------------------------
# 2. MinerU 官方云端高精解析 API 配置 (多模态版面与表格提取)
# 在 https://mineru.net/apiManage/docs 获取 Token
# ------------------------------------------------------------------------------
MINERU_API_KEY=your_mineru_api_token
MINERU_API_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_PARSER_MODE=auto
MINERU_V4_QUEUE_TIMEOUT_SECONDS=30
MINERU_AGENT_BASE_URL=https://mineru.net/api/v1/agent

# ------------------------------------------------------------------------------
# 3. 大模型、多模态、向量与重排模型标识配置 (API Key 由 Java 鉴权中心托管)
# ------------------------------------------------------------------------------
BASE_URL=https://kedaya.ai/v1
MODEL_NAME=grok-4.6
LLM_API_BACKEND=responses
VLM_REASONING_EFFORT=low

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# 4. Phase-6 跨服务 JWT 验签与模型密钥租约服务配置
# ------------------------------------------------------------------------------
JWT_ISSUER=rag-admin
JWT_AUDIENCE=rag-engine
JWT_PUBLIC_KEY_PATH=keys/rsa_public.pem

AUTH_CENTER_BASE_URL=http://127.0.0.1:8080
MODEL_KEY_SERVICE_ID=rag-engine
MODEL_KEY_SERVICE_SECRET=rag-engine-service-secret

# ------------------------------------------------------------------------------
# 5. 数据库配置 (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_enterprise
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/rag_enterprise

# ------------------------------------------------------------------------------
# 6. 应用与服务基础配置
# ------------------------------------------------------------------------------
APP_NAME=Enterprise Multimodal RAG System
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
