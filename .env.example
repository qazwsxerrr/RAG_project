# ==============================================================================
# 企业级多模态 RAG 生产架构环境配置模板 (.env.example)
# 复制本文件为 .env 并填入真实凭据即可启动
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 阿里云 OSS 对象存储 (真实云端接入模式)
# ------------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_rag_bucket_name

# ------------------------------------------------------------------------------
# 2. MinerU 官方云端高精解析 API 配置 (多模态版面与表格提取)
# 在 https://mineru.net/apiManage/docs 获取 Token
# ------------------------------------------------------------------------------
MINERU_API_KEY=your_mineru_api_token
MINERU_API_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_PARSER_MODE=auto
MINERU_V4_QUEUE_TIMEOUT_SECONDS=30
MINERU_AGENT_BASE_URL=https://mineru.net/api/v1/agent

# ------------------------------------------------------------------------------
# 3. 大模型与多模态通用接口配置 (标准 OpenAI 兼容规范)
# 文本大模型 (意图改写/HyDE假设/生成问答) 与 图像多模态 (配图解析/流程图/表格理解) 统一使用此配置
# ------------------------------------------------------------------------------
API_KEY=your_openai_compatible_api_key
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# 针对思考型视觉模型可选：low / medium / high (留空则使用默认)
VLM_REASONING_EFFORT=low

# ------------------------------------------------------------------------------
# 4. 向量化与重排模型配置 (SiliconFlow 或 OpenAI 兼容)
# ------------------------------------------------------------------------------
EMBEDDING_API_KEY=your_siliconflow_or_embedding_api_key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

RERANK_API_KEY=your_siliconflow_or_rerank_api_key
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# 5. 数据库配置 (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_enterprise
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/rag_enterprise

# ------------------------------------------------------------------------------
# 6. 应用与服务基础配置
# ------------------------------------------------------------------------------
APP_NAME=Enterprise Multimodal RAG System
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=rag-enterprise-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
