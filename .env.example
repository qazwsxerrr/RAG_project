# ==============================================================================
# 企业级多模态 RAG 生产架构环境配置模板 (.env.example)
# 复制本文件为 .env 并填入真实凭据即可启动
# 注意：大模型厂商 API Key 统一配置在 java-admin-service/.env.vault 中，严禁放入本文件！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 阿里云 OSS 对象存储 (真实云端接入模式)
# ------------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=your_aliyun_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_aliyun_oss_access_key_secret
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your_rag_bucket_name

# ------------------------------------------------------------------------------
# 2. MinerU 官方云端高精解析 API 配置 (多模态版面与表格提取)
# 在 https://mineru.net/apiManage/docs 获取 Token
# ------------------------------------------------------------------------------
MINERU_API_KEY=your_mineru_api_token
MINERU_API_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_PARSER_MODE=auto
MINERU_V4_QUEUE_TIMEOUT_SECONDS=30
MINERU_AGENT_BASE_URL=https://mineru.net/api/v1/agent

# ------------------------------------------------------------------------------
# 3. 大模型、多模态、向量与重排模型标识配置 (API Key 由 Java 鉴权中心托管)
# ------------------------------------------------------------------------------
BASE_URL=https://kedaya.ai/v1
MODEL_NAME=grok-4.6
LLM_API_BACKEND=responses
VLM_REASONING_EFFORT=low

EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------------------------------------------------------------
# 4. Phase-6 跨服务 JWT 验签与模型密钥租约服务配置
# ------------------------------------------------------------------------------
JWT_ISSUER=rag-admin
JWT_AUDIENCE=rag-engine
JWT_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json

AUTH_CENTER_BASE_URL=http://127.0.0.1:8080
MODEL_KEY_SERVICE_ID=rag-engine
MODEL_KEY_SERVICE_SECRET=rag-engine-service-secret

# ------------------------------------------------------------------------------
# 5. 数据库配置 (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_enterprise
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@localhost:5432/rag_enterprise
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 6. 应用与服务基础配置
# ------------------------------------------------------------------------------
APP_NAME=Enterprise Multimodal RAG System
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 7. Phase-7: 多模型热切换、双维滑动窗口熔断与多端容灾预警配置
# ------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key
ALERT_ERROR_THRESHOLD=5.0
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
CIRCUIT_BREAKER_MIN_CALLS=5
CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3
SLIDING_WINDOW_SIZE=100
SLIDING_WINDOW_SECONDS=300
LLM_TTFT_TIMEOUT_SECONDS=12.0
LLM_NON_STREAM_TIMEOUT_SECONDS=25.0

# 可选独立候选池 JSON 格式声明 (仅声明 provider 与模型拓扑，严禁明文 API Key！)
# LLM_FALLBACKS_JSON=[{"name":"fallback-sf-deepseek","model":"deepseek-ai/DeepSeek-V3","base_url":"https://api.siliconflow.cn/v1","provider":"siliconflow","backend":"chat_completions","weight":90,"is_active":true,"supports_vision":false}]
# ------------------------------------------------------------------------------
# 8. Phase-8: Redis 7+ 高并发限流、单用户问答并发流护栏与异步削峰队列
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_RETRIEVAL_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_CHAT_STREAMS_PER_USER=3
ACTIVE_CHAT_STREAM_TTL_SECONDS=180
UPLOAD_DEDUP_LOCK_TTL_SECONDS=15
INGEST_STREAM_KEY=rag:stream:doc_ingest
INGEST_CONSUMER_GROUP=rag_ingest_workers
INGEST_WORKER_CONCURRENCY=3
INGEST_MAX_AUTO_RETRIES=1
INGEST_PEL_IDLE_MS=900000
MAX_UPLOAD_SIZE_MB=100
PIPELINE_MEMORY_HISTORY_LIMIT=200
PDF_RENDER_CONCURRENCY=4
