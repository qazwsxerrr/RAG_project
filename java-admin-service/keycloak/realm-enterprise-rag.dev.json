{
  "realm": "enterprise-rag",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "groups": [
    {
      "name": "roles",
      "path": "/roles",
      "subGroups": [
        { "name": "admin", "path": "/roles/admin" },
        { "name": "developer", "path": "/roles/developer" },
        { "name": "accountant", "path": "/roles/accountant" },
        { "name": "employee", "path": "/roles/employee" },
        { "name": "kb_admin", "path": "/roles/kb_admin" },
        { "name": "security_admin", "path": "/roles/security_admin" },
        { "name": "dept_manager", "path": "/roles/dept_manager" },
        { "name": "executive", "path": "/roles/executive" }
      ]
    },
    {
      "name": "corp",
      "path": "/corp",
      "subGroups": [
        {
          "name": "总公司",
          "path": "/corp/总公司",
          "subGroups": [
            {
              "name": "研发中心",
              "path": "/corp/总公司/研发中心",
              "subGroups": [
                { "name": "技术部", "path": "/corp/总公司/研发中心/技术部" },
                { "name": "产品部", "path": "/corp/总公司/研发中心/产品部" }
              ]
            },
            {
              "name": "职能中心",
              "path": "/corp/总公司/职能中心",
              "subGroups": [
                { "name": "人事行政部", "path": "/corp/总公司/职能中心/人事行政部" },
                { "name": "财务部", "path": "/corp/总公司/职能中心/财务部" }
              ]
            },
            { "name": "总裁办", "path": "/corp/总公司/总裁办" }
          ]
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "rag-admin-service",
      "name": "RAG Admin Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "rag-admin-secret",
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:5173/login/oauth2/code/corp-sso",
        "http://localhost:8080/login/oauth2/code/corp-sso",
        "https://rag.sakivo.com/login/oauth2/code/corp-sso",
        "http://rag.sakivo.com/login/oauth2/code/corp-sso"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8080",
        "https://rag.sakivo.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##https://rag.sakivo.com/*"
      },
      "protocolMappers": [
        {
          "name": "dept_path",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "dept_path",
            "claim.name": "dept_path",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "dept_paths",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "dept_paths",
            "claim.name": "dept_paths",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "position_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "position_code",
            "claim.name": "position_code",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
